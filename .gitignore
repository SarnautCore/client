# Godot 4 editor and import cache
.godot/

# Godot exports
export_presets.cfg
build/
dist/

# .NET build artifacts
bin/
obj/
*.user
*.userprefs
*.suo
*.swp
.vs/
.idea/
.vscode/

# Mono / MSBuild
msbuild.binlog
*.nupkg
*.snupkg

# Native GDExtension build output
*.dll
*.so
*.dylib
*.pdb
*.lib
*.exp
*.obj
.sconsign.dblite
.scons_cache/

# Local config
.env
.env.local

# User-local converted Allods output. Mounted as a junction by
# scripts/mount-assets.ps1; the .gdignore keeps the editor from stat-scanning
# ~415k converted files on startup and on every focus regain. Runtime loads
# never needed the editor's filesystem database: imported types resolve
# through their .import sidecars and the rest goes through FileAccess.
converted/*
!converted/.gitkeep
!converted/.gdignore

# User-local native content (maps, terrain scenes). Mounted as a junction by
# scripts/mount-assets.ps1; the .gdignore keeps the editor from importing.
content/*
!content/.gdignore
# User-local upscaled texture variants. Mounted as a junction by
# scripts/mount-assets.ps1; the .gdignore keeps Godot from importing 35 GB of
# 4x PNGs that UpscaledTextures reads through FileAccess instead.
upscaled/*
!upscaled/.gdignore

# OS
.DS_Store
Thumbs.db
