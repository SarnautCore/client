# Godot 4 editor and import cache
.godot/

# Godot exports
export_presets.cfg
build/
dist/

# .NET build artifacts
bin/
obj/
*.user
*.userprefs
*.suo
*.swp
.vs/
.idea/
.vscode/

# Mono / MSBuild
msbuild.binlog
*.nupkg
*.snupkg

# Native GDExtension build output
*.dll
*.so
*.dylib
*.pdb
*.lib
*.exp
*.obj
.sconsign.dblite
.scons_cache/

# Local config
.env
.env.local

# User-local converted Allods output
converted/*
!converted/.gitkeep

# User-local upscaled texture variants. Mounted as a junction by
# scripts/mount-assets.ps1; the .gdignore keeps Godot from importing 35 GB of
# 4x PNGs that UpscaledTextures reads through FileAccess instead.
upscaled/*
!upscaled/.gdignore

# OS
.DS_Store
Thumbs.db
