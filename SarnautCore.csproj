<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SarnautCore</AssemblyName>
    <RootNamespace>SarnautCore</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);converted/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="src/SarnautCore.Network/**" />
    <Compile Remove="tests/SarnautCore.Network.Tests/**" />
    <Compile Remove="tools/**" />
    <ProjectReference Include="src/SarnautCore.Network/SarnautCore.Network.csproj" />
  </ItemGroup>
</Project>
