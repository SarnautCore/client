<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SarnautCore</AssemblyName>
    <RootNamespace>SarnautCore</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);converted*/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- The plain-C# assemblies and their tests build on their own; the Godot
         project only references them. Godot.NET.Sdk globs every .cs below the
         project directory, so each one has to be removed here as well. -->
    <Compile Remove="src/SarnautCore.Network/**" />
    <Compile Remove="src/SarnautCore.Gameplay/**" />
    <Compile Remove="src/SarnautCore.Shell/**" />
    <Compile Remove="src/SarnautCore.Content/**" />
    <Compile Remove="src/SarnautCore.UI/**" />
    <Compile Remove="tests/**" />
    <Compile Remove="tools/**" />
    <!-- The headless smoke scenes are Godot scripts and belong to this project;
         only the xUnit projects below tests/ are somebody else's. Removing all
         of tests/ compiled them out, which left every smoke scene refusing to
         instantiate its own script. -->
    <Compile Include="tests/*.cs" />
    <ProjectReference Include="src/SarnautCore.Network/SarnautCore.Network.csproj" />
    <ProjectReference Include="src/SarnautCore.Gameplay/SarnautCore.Gameplay.csproj" />
    <ProjectReference Include="src/SarnautCore.Shell/SarnautCore.Shell.csproj" />
    <ProjectReference Include="src/SarnautCore.Content/SarnautCore.Content.csproj" />
    <ProjectReference Include="src/SarnautCore.UI/SarnautCore.UI.csproj" />
  </ItemGroup>
</Project>
