{
  "schema_id": "sarnaut.ui-product/v1",
  "catalogs": {
    "cursors": "catalogs/cursors.tres",
    "sounds": "catalogs/sounds.tres"
  },
  "screens": [
    {
      "id": "login-account",
      "scene": "screens/login_account.tscn",
      "initially_visible": false,
      "roles": [
        { "id": "account-input", "node": "LoginPanel/LoginEditPanel/LoginEditLine", "initially_visible": true },
        { "id": "password-input", "node": "LoginPanel/PasswordEditPanel/PasswordEditLine", "initially_visible": true },
        { "id": "enter-button", "node": "BottomControlPanel/EnterGameButton", "initially_visible": true, "cues": { "press": "button_press" } },
        { "id": "options-button", "node": "BottomControlPanel/OptionsButton", "initially_visible": false, "cues": { "press": "button_press" } },
        { "id": "local-button", "node": "BottomControlPanel/LocalGameButton", "initially_visible": false, "cues": { "press": "button_press" } },
        { "id": "credits-button", "node": "BottomControlPanel/CreditsButton", "initially_visible": true, "cues": { "press": "button_press" } },
        { "id": "exit-button", "node": "BottomControlPanel/ExitButton", "initially_visible": true, "cues": { "press": "button_press" } }
      ],
      "actions": [
        { "id": "submit-login", "triggers": [
          { "role": "account-input", "event": "submitted" },
          { "role": "password-input", "event": "submitted" },
          { "role": "enter-button", "event": "pressed" }
        ] },
        { "id": "cancel-login", "triggers": [
          { "role": "account-input", "event": "cancelled" },
          { "role": "password-input", "event": "cancelled" }
        ] },
        { "id": "toggle-options", "triggers": [
          { "role": "options-button", "event": "toggled" }
        ] },
        { "id": "start-local-session", "triggers": [
          { "role": "local-button", "event": "pressed" }
        ] },
        { "id": "show-credits", "triggers": [
          { "role": "credits-button", "event": "pressed" }
        ] },
        { "id": "quit", "triggers": [
          { "role": "exit-button", "event": "pressed" }
        ] }
      ],
      "values": [
        { "id": "account-name", "role": "account-input", "kind": "text", "access": "read-write", "secret": false },
        { "id": "account-password", "role": "password-input", "kind": "text", "access": "read-write", "secret": true }
      ],
      "collections": [],
      "buttons": [
        { "role": "enter-button", "toggle": false, "initial_variant": "default", "variants": [
          { "id": "default", "visual_state": "default" }
        ] },
        { "role": "options-button", "toggle": true, "initial_variant": "primary", "variants": [
          { "id": "primary", "visual_state": "primary" },
          { "id": "alternate", "visual_state": "alternate" }
        ] },
        { "role": "local-button", "toggle": false, "initial_variant": "default", "variants": [
          { "id": "default", "visual_state": "default" }
        ] },
        { "role": "credits-button", "toggle": false, "initial_variant": "default", "variants": [
          { "id": "default", "visual_state": "default" }
        ] },
        { "role": "exit-button", "toggle": false, "initial_variant": "default", "variants": [
          { "id": "default", "visual_state": "default" }
        ] }
      ],
      "focus_order": [
        "account-input",
        "password-input",
        "enter-button",
        "options-button",
        "local-button",
        "credits-button",
        "exit-button"
      ]
    }
  ]
}
